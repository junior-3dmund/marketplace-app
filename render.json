{
  "services": [
    {
      "key": "frontend",
      "name": "nova-mart-frontend",
      "buildCommand": "npm install && npm run build",
      "startCommand": "npm run preview",
      "envVars": [
        {
          "key": "VITE_API_URL",
          "value": "https://nova-mart-api.onrender.com"
        }
      ]
    },
    {
      "key": "backend",
      "name": "nova-mart-backend",
      "buildCommand": "cd server && npm install",
      "startCommand": "cd server && npm start",
      "envVars": [
        {
          "key": "ADMIN_PIN",
          "sync": false
        },
        {
          "key": "JWT_SECRET",
          "sync": false
        },
        {
          "key": "PORT",
          "value": "4000"
        }
      ]
    }
  ]
}
